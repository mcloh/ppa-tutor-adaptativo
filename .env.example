# Copie este arquivo para `.env` e preencha os valores reais.
# Nunca commite o `.env` com segredos — ele já está no .gitignore.

# ---------------------------------------------------------------------------
# Núcleo
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# String de conexão MySQL usada pelo Drizzle ORM e por drizzle-kit.
DATABASE_URL=mysql://user:password@localhost:3306/ppa_tutor

# ---------------------------------------------------------------------------
# LLM — API compatível com a OpenAI Chat Completions
# (server/_core/llm.ts, usado por server/domain/tutorLlm.ts para gerar
# questões, feedback e avaliações)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Opcional — aponte para outro endpoint compatível com a API da OpenAI.
# Padrão: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Opcional — modelo usado na geração pedagógica. Padrão: gpt-5-mini
OPENAI_MODEL=gpt-5-mini

# ---------------------------------------------------------------------------
# Armazenamento de objetos — AWS S3 direto
# (server/storage.ts, server/_core/storageProxy.ts — rota GET /storage/*)
# Credenciais AWS (access key / secret) são resolvidas pela cadeia padrão do
# SDK (variáveis AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, perfil, role de
# instância etc.) — não são necessárias aqui a menos que seu ambiente não as
# forneça de outra forma.
# ---------------------------------------------------------------------------
AWS_REGION=
AWS_S3_BUCKET=
# Opcional — domínio público (ex.: CloudFront) para servir objetos sem URL
# assinada. Quando ausente, o proxy usa uma URL presignada de 5 minutos.
AWS_S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# E-mail transacional (ativação de conta e recuperação de senha)
# (server/domain/email.ts) — exige porta 465 com TLS implícito.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Hostname FQDN anunciado no HELO/EHLO (nunca IP).
SMTP_CLIENT_NAME=
# Deve usar a mesma caixa autenticada em SMTP_USER (anti-spoofing).
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Login com Conta Google (server/googleAuth.ts)
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# PagBank — pagamentos (server/domain/pagbankSandbox.ts, pagbankWebhook.ts)
# Sandbox e Produção são totalmente segregados; nunca reutilize um token no
# outro ambiente.
# ---------------------------------------------------------------------------
PAGBANK_SANDBOX_TOKEN=
PAGBANK_PRODUCTION_TOKEN=
# Chave Pix de produção (formato UUID) usada nas checagens de configuração.
PAGBANK_PRODUCTION_PIX_KEY=

# Flags de habilitação por fase comercial — todas desligadas por padrão.
# Sandbox: exige NODE_ENV=development OU PAGBANK_HOMOLOGATION_MODE=sandbox.
PAGBANK_HOMOLOGATION_MODE=
# Checkout real de produção restrito à conta de homologação.
PAGBANK_PRODUCTION_HOMOLOGATION_MODE=
# Checkout comercial real, aberto a qualquer aluno autenticado.
PAGBANK_PRODUCTION_COMMERCIAL_MODE=

# Connect Token Challenge — par RSA 2048. Prefira as variantes _BASE64 em
# ambientes publicados (uma linha só, sem quebras).
PAGBANK_CONNECT_PUBLIC_KEY=
PAGBANK_CONNECT_PRIVATE_KEY=
PAGBANK_CONNECT_PUBLIC_KEY_BASE64=
PAGBANK_CONNECT_PRIVATE_KEY_BASE64=
PAGBANK_CONNECT_KEY_CREATED_AT=

# ---------------------------------------------------------------------------
# Cliente (Vite) — analytics de terceiro (Umami), opcional
# ---------------------------------------------------------------------------
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Hosts extras liberados no dev server do Vite (separados por vírgula).
# Padrão: localhost,127.0.0.1
VITE_DEV_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Scripts e testes — opcional, usados apenas fora do runtime da aplicação
# ---------------------------------------------------------------------------
# Alvo dos smoke tests em scripts/smoke-*.mjs. Padrão: http://localhost:3000
PPA_BASE_URL=
# Paralelismo do OCR em scripts/extract-evidence-ocr.mjs. Padrão: 8
OCR_CONCURRENCY=
# Habilitam testes que dependem de rede/credenciais reais (desligados por padrão).
RUN_SMTP_LIVE=
RUN_SMTP_LIVE_DELIVERY_TEST=
RUN_PAGBANK_PIX_KEY_VALIDATION=
PAGBANK_ENABLE_PRODUCTION_AUTH_PROBE=
